---
const today = new Date();
---

<footer>
	<span>&copy; {today.getFullYear()} flyfishchen</span>
	<span class="links">
		<a href="https://github.com/flyfishchen" target="_blank" rel="noopener">GitHub</a>
		<a href="/rss.xml">RSS</a>
	</span>
</footer>
<style>
	footer {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 1.5rem 1.25rem 3rem;
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.85rem;
	}
	.links {
		display: flex;
		gap: 1rem;
	}
	a {
		color: var(--muted);
	}
	a:hover {
		color: var(--heading);
	}
	@media (max-width: 640px) {
		footer {
			padding: 1.25rem 1rem 2rem;
		}
	}
</style>
